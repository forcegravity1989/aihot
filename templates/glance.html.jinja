{% if not embed %}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="qianliyan glance">
<title>{{ page_title }} · 日报</title>
<style>{{ theme_css|safe }}</style>
</head>
<body>{% endif %}
<div class="qly-glance qly-view-inner" id="view-glance-inner">
  <div class="glance-head">
    <div class="qly-page-head">
      <h1 class="qly-page-title">📑 今日日报</h1>
      <div class="qly-page-sub">{{ date }} · 共 {{ total }} 条 · {{ group_count }} 个类目 · 扫过标题即「已接收」</div>
    </div>
    <button type="button" class="btn mark-all" id="glance-mark-all">✅ 全部已接收</button>
  </div>
  <hr class="qly-divider">
  {% for group in groups %}
  <section class="report-section" id="sec-{{ group.format }}">
    <div class="report-section-head">
      <span class="report-section-no">{{ group.no }}</span>
      <h2 class="report-section-title">{{ group.icon }} {{ group.label }}</h2>
      <span class="report-section-kicker">{{ group.format }}</span>
      <span class="report-section-count">{{ group.count }} 条</span>
    </div>
    {% for item in group.items %}
    <article class="report-entry glance-row" data-sig="{{ item.sig }}">
      <div class="report-entry-meta">
        <span class="timeline-source">{{ item.source }}</span>
        {% for badge in item.badges %}<span class="badge {{ badge.cls }}">{{ badge.text }}</span>{% endfor %}
        <span class="qly-score score-low">{{ item.date_text }}</span>
        <button type="button" class="gread" data-sig="{{ item.sig }}">标记已读</button>
      </div>
      <h3 class="report-entry-title"><a class="gtitle" href="{{ item.detail_href }}">{{ item.title }}</a></h3>
      {% if item.summary %}<p class="report-entry-summary">{{ item.summary }}</p>{% endif %}
      <div class="report-entry-meta" style="margin-top:8px">
        <a class="chip" href="{{ item.detail_href }}">详情页 →</a>
        <a class="chip glink" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>
      </div>
    </article>
    {% endfor %}
  </section>
  {% endfor %}
  {% if not groups %}<p class="glance-empty">今日暂无条目。</p>{% endif %}
</div>
<style>
.glance-head { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
.glance-head .mark-all { margin-left: auto; color: var(--accent-cyan-fg); }
.gread { border: 0; background: transparent; color: var(--text-2); font: inherit;
  font-size: 12px; cursor: pointer; padding: 0 4px; margin-left: auto; }
.gread:hover { color: var(--accent-cyan-fg); }
.glance-row.is-read { opacity: .42; }
.glance-row.is-read .gtitle { font-weight: 400; text-decoration: line-through; }
.glance-empty { color: var(--text-2); padding: 24px 4px; }
</style>
<script>
(function () {
  "use strict";
  var KEY = "qly-glance-read";
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch (e) { return {}; } }
  function save(state) { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
  var state = load();
  var rows = document.querySelectorAll(".qly-glance .glance-row");
  function apply() {
    for (var i = 0; i < rows.length; i++) {
      var sig = rows[i].getAttribute("data-sig");
      if (sig && state[sig]) { rows[i].classList.add("is-read"); }
      else { rows[i].classList.remove("is-read"); }
    }
  }
  function postHistory(sig) {
    try {
      if (window.fetch && String(location.protocol).indexOf("http") === 0) {
        fetch("/history", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ sig: sig, action: "received" })
        }).catch(function () {});
      }
    } catch (e) {}
  }
  function mark(sig) { if (!sig) { return; } state[sig] = 1; save(state); apply(); postHistory(sig); }
  var btns = document.querySelectorAll(".qly-glance .gread");
  for (var b = 0; b < btns.length; b++) {
    btns[b].addEventListener("click", function (ev) {
      ev.preventDefault();
      mark(ev.currentTarget.getAttribute("data-sig"));
    });
  }
  var all = document.getElementById("glance-mark-all");
  if (all) {
    all.addEventListener("click", function () {
      for (var i = 0; i < rows.length; i++) {
        var s = rows[i].getAttribute("data-sig");
        if (s) { state[s] = 1; postHistory(s); }
      }
      save(state); apply();
    });
  }
  apply();
})();
</script>
{% if not embed %}</body>
</html>{% endif %}
