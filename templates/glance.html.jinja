{% if not embed %}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="qianliyan glance">
<title>{{ page_title }} · 日报</title>
<style>{{ theme_css|safe }}</style>
</head>
<body>{% endif %}
<div class="qly-glance qly-view-inner" id="view-glance-inner">
  <div class="glance-head">
    <div class="qly-page-head">
      <h1 class="qly-page-title">📑 今日日报</h1>
      <div class="qly-page-sub">{{ date }} · 正文 {{ total }} 条 · 快讯 {{ quick_total }} 条 · {{ group_count }} 栏</div>
    </div>
    <button type="button" class="btn mark-all" id="glance-mark-all">✅ 全部已接收</button>
  </div>
  {% if chips %}<div class="trk-bar" role="group" aria-label="我关注的方向">
    <span class="trk-bar-k">我关注</span>
    <span class="trk-chip is-fixed" title="所有人必看">模型发布</span>
    {% for chip in chips %}<button type="button" class="trk-chip" data-follow="{{ chip.id }}" aria-pressed="{{ chip.pressed }}">{{ chip.title }}<span class="n">{{ chip.count }}</span></button>{% endfor %}
    <span class="trk-bar-hint">关注的方向展开在前，其余只看标题和结论</span>
  </div>{% endif %}
  <hr class="qly-divider">
  <div class="trk-list">
  {% for group in groups %}
  <section class="report-section trk-sec {{ group.cls }}" id="trk-{{ group.id }}" data-track="{{ group.id }}">
    <div class="report-section-head">
      <span class="report-section-no">{{ group.no }}</span>
      <h2 class="report-section-title">{{ group.title }}</h2>
      {% if group.everyone %}<span class="report-section-kicker">必看</span>{% endif %}
      {% if group.blurb %}<span class="trk-blurb">{{ group.blurb }}</span>{% endif %}
      <span class="report-section-count">{{ group.count }} 条{% if group.quick_count %} · 快讯 {{ group.quick_count }}{% endif %}</span>
      {% if not group.everyone %}<button type="button" class="trk-expand" data-track="{{ group.id }}">展开</button>{% endif %}
    </div>
    {% for item in group.items %}
    <article class="report-entry glance-row{% if item.is_lead %} is-lead{% endif %}{% if item.figure %} has-fig{% endif %}" id="e-{{ item.sig }}" data-sig="{{ item.sig }}" data-track="{{ group.id }}">
      <div class="report-entry-meta">
        <span class="timeline-source">{{ item.source }}</span>
        {% if item.is_lead %}<span class="badge badge-track">{{ item.track_title }}</span>{% endif %}
        {% for badge in item.badges %}<span class="badge {{ badge.cls }}">{{ badge.text }}</span>{% endfor %}
        <span class="qly-score score-low">{{ item.date_text }}</span>
        <button type="button" class="gread" data-sig="{{ item.sig }}">标记已读</button>
      </div>
      <h3 class="report-entry-title"><a class="gtitle" href="{{ item.detail_href }}">{{ item.title }}</a>{% if item.read_text %} <span class="read-time">（{{ item.read_text }}）</span>{% endif %}</h3>
      {% if item.takeaway %}<p class="viz-takeaway">{{ item.takeaway }}</p>{% endif %}
      {% if item.figure %}<figure class="src-fig card-fig"><a href="{{ item.detail_href }}"><img src="{{ item.figure.src }}" alt="{{ item.figure.alt }}" loading="lazy"></a><figcaption>{% if item.figure.caption %}<span>{{ item.figure.caption }}</span>{% endif %}<span class="src-credit">图源：原文{% if item.figure_more %} · 详情页另有 {{ item.figure_more }} 张{% endif %}</span></figcaption></figure>{% endif %}
      <div class="entry-body">
      {% if item.stats %}<div class="viz-stats">{% for st in item.stats %}<div class="viz-stat"><b>{{ st.value }}</b><span>{{ st.label }}</span></div>{% endfor %}</div>{% endif %}
      {% if item.logic %}<div class="viz-logic"><div class="lg-chain">{% for n in item.logic.chain %}<div class="lg-node {{ n.cls }}">{{ n.text }}</div>{% endfor %}</div>{% if item.logic.evidence %}<div class="lg-row"><span class="lg-k">证据</span>{% for ev in item.logic.evidence %}<span class="lg-ev">{{ ev }}</span>{% endfor %}</div>{% endif %}{% if item.logic.caveat %}<div class="lg-row lg-caveat"><span class="lg-k">但是</span><span>{{ item.logic.caveat }}</span></div>{% endif %}</div>{% endif %}
      {% if item.meme %}<blockquote class="viz-meme">{{ item.meme }}</blockquote>{% endif %}
      {% if item.chart %}{% if not item.figure %}<figure class="viz-chart"><figcaption>{{ item.chart.title }}</figcaption>{{ item.chart.svg|safe }}</figure>{% endif %}{% endif %}
      {% if not item.has_distill %}{% if item.brief_head %}<ul class="report-entry-brief">{% for point in item.brief_head %}<li>{{ point }}</li>{% endfor %}</ul>{% endif %}
      {% if item.brief_more %}<details class="brief-more"><summary>展开其余 {{ item.brief_more_n }} 条要点</summary><ul class="report-entry-brief">{% for point in item.brief_more %}<li>{{ point }}</li>{% endfor %}</ul></details>{% endif %}{% endif %}
      {% if item.summary %}<p class="report-entry-summary">{{ item.summary }}</p>{% endif %}
      {% if item.editor_note %}<p class="editor-note"><b>编辑短评</b> · {{ item.editor_note }}</p>{% endif %}
      <div class="report-entry-meta" style="margin-top:8px">
        <a class="chip" href="{{ item.detail_href }}">详情页 →</a>
        <a class="chip glink" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">原文 ↗</a>
      </div>
      </div>
    </article>
    {% endfor %}
    {% if group.quick %}<div class="quick-links">
      <div class="quick-k">快讯</div>
      <ul>{% for q in group.quick %}<li><a href="{{ q.url }}" target="_blank" rel="noopener noreferrer">{{ q.title }}</a>{% if q.line %}<span class="quick-line">{{ q.line }}</span>{% endif %}<span class="quick-src">{{ q.source }} · {{ q.date_text }}</span></li>{% endfor %}</ul>
    </div>{% endif %}
  </section>
  {% endfor %}
  </div>
  {% if not groups %}<p class="glance-empty">今日暂无条目。</p>{% endif %}
</div>
<style>
.glance-head { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
.glance-head .mark-all { margin-left: auto; color: var(--accent-cyan-fg); }
.gread { border: 0; background: transparent; color: var(--text-2); font: inherit;
  font-size: 12px; cursor: pointer; padding: 0 4px; margin-left: auto; }
.gread:hover { color: var(--accent-cyan-fg); }
.glance-row.is-read { opacity: .42; }
.glance-row.is-read .gtitle { font-weight: 400; text-decoration: line-through; }
.glance-empty { color: var(--text-2); padding: 24px 4px; }
/* 方向（issue #49）：关注的展开，其余收成「标题 + 一句结论」 */
.trk-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 14px; }
.trk-bar-k { font-size: 12px; font-weight: 700; color: var(--text-1); margin-right: 2px; }
.trk-bar-hint { font-size: 11.5px; color: var(--text-2); margin-left: 4px; }
.trk-chip { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 999px;
  border: 1px solid var(--border); background: transparent; color: var(--text-1); font: inherit; font-size: 12.5px;
  cursor: pointer; }
.trk-chip .n { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-2); }
.trk-chip[aria-pressed="true"], .trk-chip.is-fixed { background: var(--theme-accent-soft); color: var(--theme-accent-fg);
  border-color: transparent; font-weight: 600; }
.trk-chip.is-fixed { cursor: default; }
.trk-chip:focus-visible, .trk-expand:focus-visible { outline: 2px solid var(--theme-accent); outline-offset: 2px; }
.trk-list { display: flex; flex-direction: column; }
.trk-blurb { font-size: 12px; color: var(--text-2); }
.trk-expand { border: 1px solid var(--border); background: transparent; color: var(--text-1); font: inherit;
  font-size: 11.5px; border-radius: 6px; padding: 1px 8px; cursor: pointer; }
.trk-sec:not(.is-compact) .trk-expand { display: none; }
.trk-sec.is-compact .entry-body { display: none; }
.trk-sec.is-compact .glance-row { padding-top: 10px; padding-bottom: 10px; }
.trk-sec.is-compact .viz-takeaway { margin-bottom: 0; }
/* 没关注的方向：一行标题 + 一句结论，有原文配图就在右侧放缩略图 */
.trk-sec.is-compact .glance-row.has-fig { display: grid; grid-template-columns: minmax(0, 1fr) 132px; column-gap: 16px; }
.trk-sec.is-compact .glance-row.has-fig > * { grid-column: 1; }
.trk-sec.is-compact .glance-row.has-fig > .card-fig { grid-column: 2; grid-row: 1 / span 3; margin: 0; align-self: center; }
.trk-sec.is-compact .card-fig img { max-height: 88px; }
.trk-sec.is-compact .card-fig figcaption { display: none; }
.read-time { font-size: 12px; font-weight: 400; color: var(--text-2); white-space: nowrap; }
.badge-track { background: var(--theme-accent-soft); color: var(--theme-accent-fg); }
.quick-links { margin-top: 12px; padding: 12px 16px; border-radius: var(--radius); background: var(--bg-1);
  border: 1px solid var(--border); }
.quick-k { font-size: 11px; font-weight: 700; letter-spacing: .08em; color: var(--text-2); margin-bottom: 6px; }
.quick-links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.quick-links li { font-size: 13.5px; line-height: 1.6; }
.quick-links a { font-weight: 600; color: var(--text-0); }
.quick-line { color: var(--text-1); margin-left: 6px; }
.quick-src { display: block; font-size: 11px; color: var(--text-2); font-family: var(--font-mono); }
@media (max-width: 600px) { .trk-blurb, .trk-bar-hint { display: none; } }
</style>
<script>
(function () {
  "use strict";
  var KEY = "qly-glance-read";
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch (e) { return {}; } }
  function save(state) { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
  var state = load();
  var rows = document.querySelectorAll(".qly-glance .glance-row");
  function apply() {
    for (var i = 0; i < rows.length; i++) {
      var sig = rows[i].getAttribute("data-sig");
      if (sig && state[sig]) { rows[i].classList.add("is-read"); }
      else { rows[i].classList.remove("is-read"); }
    }
    // 侧栏「本期导读」据此刷新已读勾与进度
    try { document.dispatchEvent(new CustomEvent("qly-read-change")); } catch (e) {}
  }
  function postHistory(sig) {
    try {
      if (window.fetch && String(location.protocol).indexOf("http") === 0) {
        fetch("/history", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ sig: sig, action: "received" })
        }).catch(function () {});
      }
    } catch (e) {}
  }
  function mark(sig) { if (!sig) { return; } state[sig] = 1; save(state); apply(); postHistory(sig); }
  var btns = document.querySelectorAll(".qly-glance .gread");
  for (var b = 0; b < btns.length; b++) {
    btns[b].addEventListener("click", function (ev) {
      ev.preventDefault();
      mark(ev.currentTarget.getAttribute("data-sig"));
    });
  }
  var all = document.getElementById("glance-mark-all");
  if (all) {
    all.addEventListener("click", function () {
      for (var i = 0; i < rows.length; i++) {
        var s = rows[i].getAttribute("data-sig");
        if (s) { state[s] = 1; postHistory(s); }
      }
      save(state); apply();
    });
  }
  apply();
})();
(function () {
  "use strict";
  // 关注的方向：记在本浏览器里（取不到 localStorage 就用默认），关注的展开并排到「模型发布」后面
  var KEY = "qly-follow-tracks";
  var list = document.querySelector(".qly-glance .trk-list");
  // 关注开关可能有两处：页面顶部的方向条（窄屏/单页）和侧栏导读——同一份状态
  var chips = document.querySelectorAll("[data-follow]");
  var toc = document.querySelector(".sb-toc");
  if (!list || !chips.length) { return; }
  var follow;
  try { follow = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) { follow = null; }
  if (!Array.isArray(follow)) { follow = {{ default_follow|safe }}; }
  function secs() { return Array.prototype.slice.call(list.querySelectorAll(".trk-sec")); }
  function apply() {
    var all = secs(), fixed = [], mine = [], rest = [];
    all.forEach(function (sec) {
      var id = sec.getAttribute("data-track");
      if (sec.classList.contains("is-everyone")) { fixed.push(sec); return; }
      var on = follow.indexOf(id) >= 0;
      sec.classList.toggle("is-compact", !on);
      (on ? mine : rest).push(sec);
    });
    mine.sort(function (a, b) { return follow.indexOf(a.getAttribute("data-track")) - follow.indexOf(b.getAttribute("data-track")); });
    var order = fixed.concat(mine, rest);
    order.forEach(function (sec) { list.appendChild(sec); });
    if (toc) {
      order.forEach(function (sec) {
        var entry = toc.querySelector('.sb-sec[data-track="' + sec.getAttribute("data-track") + '"]');
        if (entry) { toc.appendChild(entry); }
      });
    }
    for (var i = 0; i < chips.length; i++) {
      chips[i].setAttribute("aria-pressed", follow.indexOf(chips[i].getAttribute("data-follow")) >= 0 ? "true" : "false");
    }
  }
  for (var i = 0; i < chips.length; i++) {
    chips[i].addEventListener("click", function (ev) {
      var id = ev.currentTarget.getAttribute("data-follow"), at = follow.indexOf(id);
      if (at >= 0) { follow.splice(at, 1); } else { follow.push(id); }
      try { localStorage.setItem(KEY, JSON.stringify(follow)); } catch (e) {}
      apply();
    });
  }
  var ex = document.querySelectorAll(".qly-glance .trk-expand");
  for (var j = 0; j < ex.length; j++) {
    ex[j].addEventListener("click", function (ev) {
      var sec = document.getElementById("trk-" + ev.currentTarget.getAttribute("data-track"));
      if (sec) { sec.classList.remove("is-compact"); }
    });
  }
  apply();
})();
</script>
{% if not embed %}</body>
</html>{% endif %}
