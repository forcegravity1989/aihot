<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="qianliyan item">
<title>{{ title }} · {{ page_title }}</title>
<style>{{ theme_css|safe }}</style>
</head>
<body>
<article class="dt-page" data-sig="{{ sig }}">

  <div class="dt-topbar">
    <a class="dt-back" href="{{ back_href }}">← 返回日报</a>
    <div class="dt-topbar-right">
      <span class="chip chip-cyan">{{ icon }} {{ label }}</span>
      <span class="qly-score {{ score_cls }}">{{ score_text }}</span>
      {% if url %}<a class="btn btn-primary" href="{{ url }}" target="_blank" rel="noopener noreferrer">打开原文 ↗</a>{% endif %}
    </div>
  </div>

  <h1 class="dt-title">{{ title }}</h1>
  <div class="dt-meta">{{ source_text }} · {{ date_abs }}{% if date_rel %} · {{ date_rel }}{% endif %}</div>
  {% if badges %}
  <div class="dt-tags" style="margin-top:12px">
    {% for badge in badges %}<span class="badge {{ badge.cls }}">{{ badge.text }}</span>{% endfor %}
  </div>
  {% endif %}

  {% if takeaway %}<p class="viz-takeaway dt-takeaway">{{ takeaway }}</p>{% endif %}

  {% if has_images %}
  <section class="dt-sec dt-figures">
    {% for fig in images %}<figure class="src-fig"><img src="{{ fig.src }}" alt="{{ fig.alt }}" loading="lazy"><figcaption>{% if fig.caption %}<span>{{ fig.caption }}</span>{% endif %}<span class="src-credit">图源：<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ source_text }} 原文</a></span></figcaption></figure>{% endfor %}
  </section>
  {% endif %}

  <section class="dt-sec">
      {% if meme %}<blockquote class="viz-meme">{{ meme }}</blockquote>{% endif %}
      {% if logic %}<div class="viz-logic"><div class="lg-chain">{% for n in logic.chain %}<div class="lg-node {{ n.cls }}">{{ n.text }}</div>{% endfor %}</div>{% if logic.evidence %}<div class="lg-row"><span class="lg-k">证据</span>{% for ev in logic.evidence %}<span class="lg-ev">{{ ev }}</span>{% endfor %}</div>{% endif %}{% if logic.caveat %}<div class="lg-row lg-caveat"><span class="lg-k">但是</span><span>{{ logic.caveat }}</span></div>{% endif %}</div>{% endif %}</section>
  {% if stats %}<section class="dt-sec"><div class="viz-stats">{% for st in stats %}<div class="viz-stat"><b>{{ st.value }}</b><span>{{ st.label }}</span></div>{% endfor %}</div></section>{% endif %}
  {% if chart %}<section class="dt-sec"><figure class="viz-chart"><figcaption>{{ chart.title }}</figcaption>{{ chart.svg|safe }}</figure></section>{% endif %}

  {% if brief %}
  <section class="dt-sec">
    <div class="dt-sec-label">细节要点</div>
    <ul class="report-entry-brief">{% for point in brief %}<li>{{ point }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if summary %}
  <section class="dt-sec">
    <div class="dt-sec-label">AI 导读</div>
    <p class="dt-body">{{ summary }}</p>
  </section>
  {% endif %}

  {% if editor_note %}
  <section class="dt-sec">
    <div class="dt-sec-label">编辑为什么选它</div>
    <p class="editor-note">{{ editor_note }}</p>
  </section>
  {% endif %}

  {% if is_video %}
  <section class="dt-sec">
    <div class="dt-sec-label">🎤 演讲{% if has_transcript %} · 已读字幕全文{% endif %}</div>
    {% if thumbnail %}<div class="dt-figure"><img src="{{ thumbnail }}" alt="{{ title }}" loading="lazy"></div>{% endif %}
  </section>
  {% endif %}

  {% if is_repo %}
  <section class="dt-sec">
    <div class="dt-sec-label">📦 仓库</div>
    <div class="dt-tags">
      {% if stars %}<span class="chip">⭐ {{ stars }}</span>{% endif %}
      {% if stars_period %}<span class="chip chip-amber">本期 +{{ stars_period }}</span>{% endif %}
      {% if language %}<span class="chip">{{ language }}</span>{% endif %}
    </div>
  </section>
  {% endif %}

  {% if theses %}
  <hr class="dt-rule">
  <section class="dt-sec">
    <div class="dt-sec-label">💡 关键论点</div>
    <ul class="dt-list">{% for thesis in theses %}<li>{{ thesis }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if corroboration %}
  <hr class="dt-rule">
  <section class="dt-sec">
    <div class="dt-sec-label">🔬 叙事 ↔ 实证</div>
    <div class="dt-corrob dt-corrob-{{ corroboration.verdict }}">
      <span class="badge">{{ corroboration.label }}</span>
      {% if corroboration.claim %}<p class="dt-body" style="margin-top:8px">{{ corroboration.claim }}</p>{% endif %}
      {% if corroboration.evidence %}<p class="dt-body" style="margin-top:6px"><b>证据</b> · {{ corroboration.evidence }}</p>{% endif %}
    </div>
  </section>
  {% endif %}

  {% if show_distill %}
  <hr class="dt-rule">
  <section class="dt-sec">
    <div class="dt-sec-label">深读提炼</div>
    <div class="dt-grid">
      <div class="dt-kv">
        <div class="dt-kv-k">要点</div>
        <div class="dt-kv-v">{% if kp %}<ul class="dt-list">{% for k in kp %}<li>{{ k }}</li>{% endfor %}</ul>{% endif %}{% if not kp %}—{% endif %}</div>
      </div>
      <div class="dt-kv">
        <div class="dt-kv-k">脉络</div>
        <div class="dt-kv-v">{% if chain %}{{ chain }}{% endif %}{% if not chain %}—{% endif %}</div>
      </div>
      <div class="dt-kv">
        <div class="dt-kv-k">影响</div>
        <div class="dt-kv-v">{% if pull %}{{ pull }}{% endif %}{% if not pull %}—{% endif %}</div>
      </div>
      <div class="dt-kv">
        <div class="dt-kv-k">局限</div>
        <div class="dt-kv-v">{% if limits %}{{ limits }}{% endif %}{% if not limits %}—{% endif %}</div>
      </div>
    </div>
  </section>
  {% endif %}

  <hr class="dt-rule">
  <section class="dt-sec">
    <div class="dt-sec-label">来源{% if source_count_text %} · {{ source_count_text }}{% endif %}</div>
    <div class="dt-tags">
      {% for src in source_list %}<span class="chip">{{ src.name }}</span>{% endfor %}
    </div>
  </section>

  {% if related %}
  <hr class="dt-rule">
  <section class="dt-sec">
    <div class="dt-sec-label">同一事件的其它报道</div>
    <ul class="dt-related">
      {% for r in related %}<li><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.title }}</a> <span class="dt-related-src">{{ r.source }}</span></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <hr class="dt-rule">
  <div class="dt-sec">
    <a class="dt-back" href="{{ back_href }}">← 返回日报</a>
  </div>

</article>
</body>
</html>
