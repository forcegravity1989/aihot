{% if not embed %}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="qianliyan deep">
<title>{{ page_title }} · 深读</title>
<style>{{ theme_css|safe }}</style>
</head>
<body>{% endif %}
<style>
/* 深读卡：详情页的「预览态」——版式与 .dt-* 同源（同一套 token / 同样的区块标签），
   区别只在这里是流式卡片、点进去才是完整详情页。 */
.deep-card { padding: 20px 22px; margin-top: 16px; border: 1px solid var(--border);
  border-radius: var(--radius); background: var(--surface-card); box-shadow: var(--shadow-card);
  transition: border-color var(--dur-base) ease, box-shadow var(--dur-base) ease; }
.deep-card:hover { border-color: var(--border-card-subtle-solid); box-shadow: var(--shadow-card-hover); }
.deep-card-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.dfmt { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); }
.deep-h2 { margin: 0 0 8px; font-size: 19px; font-weight: 700; line-height: 1.4; letter-spacing: -.01em; }
.deep-h2 a:hover { color: var(--accent-cyan-fg); }
.deep-summary { margin: 0; font-size: 14.5px; line-height: var(--line-height-relaxed); color: var(--text-1); }
.deep-tag-line { font-size: 12.5px; color: var(--text-2); margin-bottom: 8px; }
.deep-thumb img, .deep-images img { width: 100%; border-radius: var(--radius-sm);
  border: 1px solid var(--border-soft); }
.deep-images { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin: 12px 0; }
.deep-repo { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.deep-theses { margin-top: 14px; }
.deep-theses ul { margin: 6px 0 0; padding-left: 20px; font-size: 14px;
  line-height: var(--line-height-relaxed); color: var(--text-1); }
.deep-block-title { font-size: 13px; font-weight: 700; color: var(--theme-accent-fg); }
.deep-corrob { margin-top: 14px; padding: 12px 14px; border-radius: var(--radius-sm);
  border: 1px solid var(--border-soft); background: var(--surface-0); font-size: 13.5px; }
.deep-corrob-corroborated { border-color: var(--accent-emerald-soft); background: var(--accent-emerald-soft); }
.deep-corrob-unverified { border-color: var(--accent-amber-soft); background: var(--accent-amber-soft); }
.deep-corrob-contradicted { border-color: var(--accent-rose-soft); background: var(--accent-rose-soft); }
.corrob-claim { color: var(--text-1); margin-left: 6px; }
.corrob-evidence { margin-top: 6px; color: var(--text-1); }
.deep-distill { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  margin-top: 16px; }
.dsec { padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: var(--radius-sm);
  background: var(--surface-0); }
.dsec-k { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); }
.dsec p { margin: 4px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--text-0); }
.dsec ul { margin: 4px 0 0; padding-left: 18px; font-size: 13.5px; line-height: 1.6; color: var(--text-0); }
.deep-cross { margin-top: 16px; font-size: 13px; color: var(--text-1); }
.deep-cross summary { cursor: pointer; color: var(--text-2); }
.cross-list { margin: 8px 0; padding-left: 20px; }
.deep-foot { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
.deep-empty { color: var(--text-2); padding: 24px 4px; }
</style>
<div class="qly-deep qly-view-inner" id="view-deep-inner">
  <div class="qly-page-head">
    <h1 class="qly-page-title">📖 深读精读</h1>
    <div class="qly-page-sub">{{ date }} · 共 {{ total }} 条 · 全文重点研读，突出图片与论点</div>
  </div>
  <hr class="qly-divider">
  {% for card in cards %}
  <article class="deep-card" data-sig="{{ card.sig }}" data-format="{{ card.format }}">
    <div class="deep-card-head">
      <span class="dfmt">{{ card.icon }} {{ card.label }}</span>
      {% for badge in card.badges %}<span class="badge dbadge">{{ badge }}</span>{% endfor %}
    </div>

    <h2 class="deep-h2"><a href="{{ card.detail_href }}">{{ card.title }}</a></h2>

    {% if card.is_video %}
    <div class="deep-tag-line">🎤 演讲要点{% if card.has_transcript %} · 已读字幕全文{% endif %}</div>
    {% if card.thumbnail %}<div class="deep-thumb"><img src="{{ card.thumbnail }}" alt="{{ card.title }}" loading="lazy"></div>{% endif %}
    {% endif %}
    {% if card.is_repo %}
    <div class="deep-repo">
      {% if card.stars %}<span class="chip repo-stars">⭐ {{ card.stars }}</span>{% endif %}
      {% if card.stars_period %}<span class="chip chip-amber repo-delta">本期 +{{ card.stars_period }}</span>{% endif %}
      {% if card.language %}<span class="chip repo-lang">{{ card.language }}</span>{% endif %}
    </div>
    {% endif %}
    {% if card.is_paper %}
    <div class="deep-tag-line">📄 论文摘要{% if card.arxiv_url %} · <a href="{{ card.arxiv_url }}" target="_blank" rel="noopener noreferrer">arXiv</a>{% endif %}</div>
    {% endif %}

    {% if card.has_images %}
    <div class="deep-images">
      {% for img in card.images %}<img src="{{ img }}" alt="配图" loading="lazy">{% endfor %}
    </div>
    {% endif %}

    {% if card.summary %}<p class="deep-summary">{{ card.summary }}</p>{% endif %}

    {% if card.theses %}
    <div class="deep-theses">
      <div class="deep-block-title">💡 关键论点</div>
      <ul>{% for t in card.theses %}<li>{{ t }}</li>{% endfor %}</ul>
    </div>
    {% endif %}

    {% if card.corroboration %}
    <div class="deep-corrob deep-corrob-{{ card.corroboration.verdict }}">
      <span class="badge corrob-badge">{{ card.corroboration.label }}</span>
      {% if card.corroboration.claim %}<span class="corrob-claim">{{ card.corroboration.claim }}</span>{% endif %}
      {% if card.corroboration.evidence %}<div class="corrob-evidence">证据 · {{ card.corroboration.evidence }}</div>{% endif %}
    </div>
    {% endif %}

    <div class="deep-distill">
      <div class="dsec">
        <span class="dsec-k">要点</span>
        {% if card.kp %}<ul>{% for k in card.kp %}<li>{{ k }}</li>{% endfor %}</ul>{% endif %}
        {% if not card.kp %}<p>—</p>{% endif %}
      </div>
      <div class="dsec"><span class="dsec-k">脉络</span><p>{% if card.chain %}{{ card.chain }}{% endif %}{% if not card.chain %}—{% endif %}</p></div>
      <div class="dsec"><span class="dsec-k">影响</span><p>{% if card.pull %}{{ card.pull }}{% endif %}{% if not card.pull %}—{% endif %}</p></div>
      <div class="dsec"><span class="dsec-k">局限</span><p>{% if card.limits %}{{ card.limits }}{% endif %}{% if not card.limits %}—{% endif %}</p></div>
    </div>

    <details class="deep-cross">
      <summary>🔎 交叉验证 · {{ card.source_count }} 源</summary>
      <ul class="cross-list">
        {% for s in card.source_list %}<li>{{ s.name }}</li>{% endfor %}
      </ul>
    </details>

    <div class="deep-foot">
      <a class="btn" href="{{ card.detail_href }}">读详情页 →</a>
      <a class="btn btn-primary deep-original" href="{{ card.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
    </div>
  </article>
  {% endfor %}
  {% if not cards %}<p class="deep-empty">今日暂无条目。</p>{% endif %}
</div>
{% if not embed %}</body>
</html>{% endif %}
