<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
</head>
<body style="margin:0;padding:0;background:#faf9f5;">
<!-- 公众号深度解读（每天第二篇，正文类型）：和日报公众号稿同一套 token（ivory #faf9f5 / 卡片 #fefdfa / 赤陶 #d97757）。
     公众号只保留行内样式：全部 style=""，不用 flex / grid / position / 伪元素，不用斜体；外链不可点，原文地址写成纯文本。 -->
<section style="background:#faf9f5;padding:18px 16px 28px;color:#1f1e1d;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Hiragino Sans GB,Microsoft YaHei,sans-serif;font-size:16px;line-height:1.85;letter-spacing:0.02em;">

  <section style="padding:0 2px 14px;border-bottom:1px solid #d7d2ca;">
    <p style="margin:0;font-size:12px;line-height:1.5;color:#75716a;letter-spacing:0.08em;"><span style="display:inline-block;width:20px;height:20px;line-height:20px;text-align:center;border-radius:6px;background:#d97757;color:#ffffff;font-weight:700;font-size:12px;letter-spacing:0;margin-right:6px;vertical-align:middle;">千</span>千里眼 · 深度解读 · {{ date_label }}</p>
    <p style="margin:8px 0 0;font-size:12.5px;line-height:1.6;color:#6b6760;">解读：{{ source_title }} · 来源 {{ source }} · 读完约 {{ minutes }} 分钟</p>
  </section>

  <!-- 导语：先给结论 -->
  <section style="margin-top:20px;padding:14px 16px;border-left:3px solid #d97757;background:#fefdfa;border-radius:0 10px 10px 0;">
    <p style="margin:0;font-size:16px;line-height:1.85;font-weight:600;color:#1f1e1d;">{{ lede }}</p>
  </section>

  <!-- 关键数字：每个都和原文逐字核对过 -->
  <section style="margin-top:18px;">
    <p style="margin:0;font-size:12px;font-weight:700;line-height:1.6;color:#af5233;letter-spacing:0.08em;">关键数字 · 均与原文逐字核对</p>
    <p style="margin:6px 0 0;line-height:2.2;">{% for n in numbers %}<span style="display:inline-block;margin:0 6px 6px 0;padding:2px 10px;border:1px solid #ebd5c8;border-radius:999px;background:#fefdfa;color:#af5233;font-size:14px;font-weight:700;line-height:1.7;letter-spacing:0;">{{ n }}</span>{% endfor %}</p>
  </section>

  {% for sec in sections %}<section style="margin-top:26px;">
    <p style="margin:0 0 10px;padding-bottom:6px;border-bottom:1px solid #ebe7e1;"><span style="font-size:13px;font-weight:700;color:#af5233;letter-spacing:0;">{{ sec.no }}</span><span style="font-size:18px;font-weight:800;margin-left:8px;letter-spacing:0;">{{ sec.heading }}</span></p>
    {% for p in sec.paras %}<p style="margin:0 0 12px;font-size:16px;line-height:1.85;color:#2b2a28;">{{ p }}</p>{% endfor %}
    {% if sec.fig %}<section style="margin:6px 0 12px;border:1px solid #ebe7e1;border-radius:10px;background:#fefdfa;overflow:hidden;">
      <section style="background:#f0eee6;text-align:center;line-height:0;"><img src="{{ sec.fig.src }}" alt="{{ sec.fig.alt }}" style="display:block;width:100%;height:auto;margin:0;"></section>
      <p style="margin:0;padding:8px 12px 10px;font-size:13px;line-height:1.6;color:#58554f;"><span style="color:#75716a;">{{ sec.fig_credit }}</span>{% if sec.note %} · <span style="font-weight:700;color:#af5233;">{{ sec.note }}</span>{% endif %}</p>
    </section>{% endif %}
  </section>{% endfor %}

  <section style="margin-top:26px;padding:14px 16px;border:1px solid #ebe7e1;border-radius:12px;background:#fefdfa;">
    <p style="margin:0 0 6px;font-size:15px;font-weight:800;color:#1f1e1d;letter-spacing:0;">局限与存疑</p>
    {% for c in caveats %}<p style="margin:6px 0 0;font-size:15px;line-height:1.75;color:#3d3b37;">· {{ c }}</p>{% endfor %}
  </section>

  <section style="margin-top:14px;padding:14px 16px;border:1px solid #d97757;border-radius:12px;background:#fefdfa;">
    <p style="margin:0 0 6px;font-size:15px;font-weight:800;color:#af5233;letter-spacing:0;">对你意味着什么</p>
    {% for s in so_what %}<p style="margin:6px 0 0;font-size:15px;line-height:1.75;color:#1f1e1d;">· {{ s }}</p>{% endfor %}
  </section>

  <section style="margin-top:24px;padding-top:14px;border-top:1px solid #d7d2ca;">
    <p style="margin:0;font-size:12.5px;line-height:1.7;color:#6b6760;">原文：{{ source_title }}（{{ source }}）</p>
    <p style="margin:2px 0 0;font-size:12px;line-height:1.6;color:#8a857d;word-break:break-all;">{{ url }}</p>
    <p style="margin:10px 0 0;font-size:12px;line-height:1.7;color:#8a857d;">千里眼编辑读原文全文写成，文中事实与数字均出自原文；推断处已注明。原文图版权归原作者。今天的其余要闻见同日贴图「N 秒读完」。</p>
  </section>
</section>
</body>
</html>
