<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="qianliyan {{ version }}">
<title>{{ page_title }}</title>
<style>{{ theme_css|safe }}</style>
<style>
/* 简报页沿用了一批历史类名（.card / .board / .sidebar…），它们引用的是旧变量名。
   这里把旧名字**别名到设计系统 token** 上：颜色的唯一真值仍在 templates/_theme.css，
   这一层只做改名映射，不再自带任何色值——所以改主题只改 _theme.css 一处。 */
:root {
  --bg: var(--bg-0);
  --card: var(--surface-card);
  --ink: var(--text-0);
  --muted: var(--text-1);
  --faint: var(--text-2);
  --line: var(--border);
  --brand: var(--theme-accent);
  --brand-soft: var(--theme-accent-soft);
  --hot: var(--accent-rose-fg);
  --heavy: var(--accent-amber-fg);
  --heavy-soft: var(--accent-amber-soft);
  --flash: var(--accent-cyan-fg);
  --flash-soft: var(--accent-cyan-soft);
  --ink-soft: var(--sidebar-bg);
  --shadow: var(--shadow-card);
  --sidebar-w: 232px;
}
body { font-size: 15px; line-height: 1.6; }
a:hover { text-decoration: underline; }

/* ---------- 整体布局：侧栏 + 主体 ---------- */
.layout { max-width: 1440px; margin: 0 auto; display: flex; align-items: flex-start; }

/* ---------- 侧栏（左，粘性） ---------- */
.sidebar {
  position: sticky; top: 0; height: 100vh; width: var(--sidebar-w); flex: 0 0 var(--sidebar-w);
  display: flex; flex-direction: column;
  background: var(--sidebar-bg); color: var(--text-1);
  border-right: 1px solid var(--sidebar-border);
  padding: 22px 12px 14px; overflow-y: auto;
}
.sidebar-brand h1 { font-size: 17px; margin: 0; font-weight: 800; letter-spacing: .04em; color: var(--text-0); }
.sidebar-brand .subtitle {
  color: var(--text-2); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase;
  margin-top: 3px; display: block;
}
.sidebar-stats {
  margin-top: 16px; padding: 10px 12px; border: 1px solid var(--border-soft);
  border-radius: var(--radius-sm); background: var(--surface-0);
  font-size: 11px; color: var(--text-2); display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px;
}
.sidebar-stats b {
  display: block; color: var(--text-0); font-family: var(--font-mono); font-size: 15px;
  font-weight: 700; font-variant-numeric: tabular-nums;
}
.sidebar-stats span { display: block; margin-top: 1px; }
.sidebar-updated { margin-top: 10px; color: var(--text-2); font-size: 10.5px; }

.sidebar-section { margin-top: 20px; }
.sidebar-label {
  font-size: 10.5px; font-weight: 700; letter-spacing: .1em; color: var(--text-2);
  margin: 0 0 6px; padding: 0 8px;
}
.sortbar { display: flex; flex-direction: column; gap: 2px; }
.sort-btn {
  border: 0; background: transparent; color: var(--text-1); cursor: pointer; text-align: left;
  font: inherit; font-size: 13.5px; padding: 6px 10px; border-radius: var(--radius-sm);
  transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
}
.sort-btn:hover { background: var(--surface-1); color: var(--text-0); }
.sort-btn[aria-pressed="true"] { background: var(--theme-accent-soft); color: var(--theme-accent-fg); font-weight: 600; }
.palette-hint {
  width: 100%; border: 1px solid var(--border); background: var(--surface-card);
  border-radius: var(--radius-sm); padding: 7px 10px; font-size: 12.5px; color: var(--text-1);
  cursor: pointer; text-align: left; display: flex; align-items: center; justify-content: space-between;
}
.palette-hint:hover { border-color: var(--border-emphasis); color: var(--text-0); }
kbd {
  font-family: var(--font-mono); font-size: 11px;
  background: var(--surface-2); border: 1px solid var(--border-strong); border-bottom-width: 2px;
  border-radius: 5px; padding: 0 5px; color: var(--text-1);
}

/* ---------- 侧栏版面导航（纵向列表，不是横向 chip） ---------- */
.boardnav { display: flex; flex-direction: column; gap: 1px; }
.boardnav a {
  font-size: 13.5px; color: var(--text-1); border-radius: var(--radius-sm); padding: 6px 10px;
  display: flex; justify-content: space-between; gap: 8px;
}
.boardnav a:hover { background: var(--surface-1); color: var(--text-0); text-decoration: none; }
.boardnav .n { color: var(--text-2); font-family: var(--font-mono); font-size: 11.5px; font-variant-numeric: tabular-nums; }
.sidebar-foot { margin-top: auto; padding-top: 14px; color: var(--text-2); font-size: 10.5px; }

/* ---------- 变更情报版面 ----------
   「他说的被真实的代码/提示词 diff 证实了吗」——版本变更卡（token 增减）+ 叙事↔实证
   映射。这批数据此前算了就扔，只活在内存里。 */
.chg-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
.chg-card {
  padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: var(--radius-sm);
  background: var(--surface-0);
}
.chg-subject { font-size: 13.5px; font-weight: 600; color: var(--text-0); }
.chg-ver { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-2); margin-left: 6px; }
.chg-meta { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap;
  font-size: 11.5px; color: var(--text-2); }
.corrob-list { list-style: none; margin: 14px 0 0; padding: 0; }
.corrob-row { padding: 12px 0; border-top: 1px dashed var(--border); }
.corrob-row:first-child { border-top: 0; }
.corrob-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.corrob-title { font-size: 14px; font-weight: 600; }
.corrob-claim { margin: 6px 0 0; font-size: 13px; line-height: 1.7; color: var(--text-1); }
.corrob-ev { margin: 4px 0 0; font-size: 12.5px; color: var(--text-2); }

/* ---------- 主体 ---------- */
.main-col { flex: 1; min-width: 0; padding: 28px 32px 72px; }

/* ---------- 头条区：日报主体开场 ----------
   参照 TLDR AI 的做法：不放配图，头条条目就是加粗大字标题 + 完整摘要段落，
   排版层级靠字号/字重/留白做出来，不是靠图片和卡片阴影。 */
.hero { margin-bottom: 36px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
.hero-label {
  font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
  margin: 0 0 14px; display: flex; align-items: center; gap: 8px;
}
.hero-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.hero-main .card-title { font-size: 24px; line-height: 1.35; font-weight: 700; }
.hero-summary { -webkit-line-clamp: 4; font-size: 15px; margin-top: 10px; }
.hero-side { list-style: none; margin: 22px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); }
.hero-row { padding: 12px 0; border-top: 1px dashed var(--line); }
.hero-row:first-child { border-top: 0; padding-top: 0; }
.hero-row .card-title { font-size: 16px; }

/* ---------- 版面 ---------- */
.board { margin-top: 30px; scroll-margin-top: 20px; }
.board-head { display: flex; align-items: baseline; gap: 10px; border-bottom: 2px solid var(--ink); padding-bottom: 8px; }
.board-head h2 { font-size: 17px; margin: 0; }
.board-head .n { color: var(--faint); font-size: 13px; }
.board-head .desc { color: var(--muted); font-size: 13px; margin-left: auto; }
.cards { list-style: none; margin: 0; padding: 0; }
/* 参照 Techmeme/Hacker News 的信息密度：条目是列表行，不是带阴影的独立卡片——
   视觉层级靠字重/留白/分隔线做，不靠圆角+阴影的"产品卡片"堆叠。 */
.card {
  display: flex; gap: 12px; padding: 13px 2px; border-top: 1px solid var(--line);
  scroll-margin-top: 20px;
}
.cards .card:first-child { border-top: 0; }
.card.qly-flash-target { background: var(--brand-soft); margin: 0 -10px; padding-left: 10px; padding-right: 10px; border-radius: 8px; }
.avatar {
  width: 30px; height: 30px; border-radius: 50%; flex: 0 0 30px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 600; color: #fff; overflow: hidden; object-fit: cover;
}
.card-main { min-width: 0; flex: 1; }
.card-title { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.5; }
.card-title a:hover { color: var(--brand); }
.badge {
  display: inline-block; font-size: 12px; font-weight: 600; border-radius: 6px;
  padding: 1px 7px; margin-right: 6px; vertical-align: 1px;
}
.badge-heavy { background: var(--heavy-soft); color: var(--heavy); }
.badge-flash { background: var(--flash-soft); color: var(--flash); }
.card-summary {
  margin: 5px 0 0; color: var(--muted); font-size: 13.5px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
/* 「更多信源」——照 Techmeme「More: A, B, C」的做法做成醒目正文行，
   不是角落里的小灰字标签：交叉验证是这款产品的核心主张，值得被看见。 */
.more-sources {
  margin: 6px 0 0; padding-left: 10px; border-left: 2px solid var(--brand);
  color: var(--ink); font-size: 13px; line-height: 1.5;
}
.card-meta { margin-top: 7px; color: var(--faint); font-size: 12.5px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.card-meta .sources { color: var(--muted); }
.card-meta .hotness { color: var(--hot); font-weight: 600; }
.card-meta .tier { border: 1px solid var(--line); border-radius: 5px; padding: 0 6px; }
.card-meta .go { color: var(--brand); margin-left: auto; }
.empty { color: var(--faint); font-size: 13.5px; padding: 18px 4px; }

/* ---------- 特别版面：为你推荐 / 人物画像 ---------- */
.special-board { margin-top: 34px; scroll-margin-top: 20px; }
.special-board .board-head { border-bottom-color: var(--brand); }
.reasons { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
.reason-chip, .topic-chip {
  display: inline-block; font-size: 12px; border-radius: 999px;
  padding: 1px 9px; background: var(--brand-soft); color: var(--brand);
  border: 1px solid var(--line);
}
.pscore { color: var(--flash); font-weight: 600; }

.persona-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px; margin-top: 12px;
}
.persona-card {
  background: var(--card); border: 1px solid var(--line); border-radius: 12px;
  padding: 14px 16px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 8px;
}
.persona-top { display: flex; align-items: center; gap: 10px; }
.persona-top .avatar { width: 42px; height: 42px; flex: 0 0 42px; font-size: 16px; }
.persona-name { font-size: 15px; font-weight: 600; line-height: 1.3; }
.persona-handle { color: var(--faint); font-size: 12.5px; }
.persona-bio { color: var(--muted); font-size: 13px; margin: 0; }
.persona-focus { font-size: 13px; }
.persona-focus b { color: var(--brand); font-weight: 600; }
.persona-topics { display: flex; flex-wrap: wrap; gap: 6px; }
.persona-tops { list-style: none; margin: 0; padding: 0; font-size: 13px; }
.persona-tops li { margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.persona-tops a:hover { color: var(--brand); }
.persona-stats {
  margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--line);
  color: var(--muted); font-size: 12.5px; display: flex; gap: 14px;
}
.persona-stats b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

/* ---------- 命令面板 ---------- */
.palette-mask {
  display: none; position: fixed; inset: 0; z-index: 90;
  background: rgba(23, 26, 33, .35); backdrop-filter: blur(2px);
  padding: 12vh 16px 16px;
}
.palette-mask.open { display: block; }
.palette {
  max-width: 640px; margin: 0 auto; background: var(--card); border-radius: 14px;
  box-shadow: 0 24px 64px rgba(23, 26, 33, .28); overflow: hidden;
}
.palette input {
  width: 100%; border: 0; border-bottom: 1px solid var(--line); outline: none;
  font: inherit; font-size: 16px; padding: 16px 18px; color: var(--ink); background: transparent;
}
.palette-results { list-style: none; margin: 0; padding: 6px; max-height: 46vh; overflow-y: auto; }
.palette-results li { padding: 9px 12px; border-radius: 9px; cursor: pointer; }
.palette-results li.active { background: var(--brand-soft); }
.palette-results .pt { font-size: 14px; }
.palette-results .pm { font-size: 12px; color: var(--faint); margin-top: 2px; }
.palette-foot {
  display: flex; gap: 14px; padding: 9px 16px; border-top: 1px solid var(--line);
  color: var(--faint); font-size: 12px;
}
.palette-empty { color: var(--faint); font-size: 13px; padding: 18px; text-align: center; }

footer { margin-top: 46px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--faint); font-size: 12.5px; }

@media (max-width: 900px) {
  .layout { display: block; }
  .sidebar { position: static; width: 100%; height: auto; flex: none; }
  .sidebar-section:has(.boardnav) { min-height: 0 !important; }
  .boardnav { max-height: 260px; }
  .main-col { padding: 20px 16px 56px; }
}
@media (max-width: 640px) {
  .board-head .desc { display: none; }
}
</style>
</head>
<body>

<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <h1>{{ page_title }}</h1>
      <span class="subtitle">{{ subtitle }}</span>
    </div>
    <div class="sidebar-stats">
      <div><b>{{ total_items }}</b><span>条信息</span></div>
      <div><b>{{ board_count }}</b><span>个版面</span></div>
      <div><b>{{ heavy_count }}</b><span>📈 重磅</span></div>
      <div><b>{{ flash_count }}</b><span>⚡ 一手速报</span></div>
    </div>
    <div class="sidebar-updated">生成于 {{ generated_at }}</div>

    <div class="sidebar-section">
      <p class="sidebar-label">排序</p>
      <div class="sortbar" role="group" aria-label="排序方式">
        <button type="button" class="sort-btn" id="qly-sort-hot" data-sort="hot" aria-pressed="true">🔥 热度</button>
        <button type="button" class="sort-btn" id="qly-sort-time" data-sort="time" aria-pressed="false">🕒 时间</button>
        <button type="button" class="sort-btn" id="qly-sort-score" data-sort="score" aria-pressed="false">📈 得分</button>
      </div>
    </div>

    <div class="sidebar-section">
      <button type="button" class="palette-hint" id="qly-palette-open">
        <span>🔍 搜索全部版面</span><span><kbd>Ctrl</kbd>+<kbd>K</kbd></span>
      </button>
    </div>

    <div class="sidebar-section" style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
      <p class="sidebar-label">版面导航</p>
      <nav class="boardnav" aria-label="版面导航" style="overflow-y: auto;">
        {% if personalized %}<a href="#board-personalized">✨ 为你推荐<span class="n">{{ personalized_count }}</span></a>{% endif %}
        {% if change_cards %}
        <section class="board" id="board-change">
          <div class="board-head">
            <h2>🔬 变更情报</h2>
            <span class="n">{{ change_count }} 张变更卡 · {{ corroboration_count }} 条实证核验</span>
            <span class="desc">叙事 ↔ 实证：说法有没有被真实的 diff 证实</span>
          </div>
          <div class="chg-grid">
            {% for card in change_cards %}
            <div class="chg-card">
              <div><span class="chg-subject">{{ card.subject }}</span><span class="chg-ver">{{ card.version }}</span></div>
              <div class="chg-meta">
                {% if card.delta_text %}<span class="badge {{ card.delta_cls }}">{{ card.delta_text }}</span>{% endif %}
                <span>{{ card.count_text }}</span>
                {% if card.refs_text %}<span>· {{ card.refs_text }}</span>{% endif %}
                {% if card.url %}<a href="{{ card.url }}" target="_blank" rel="noopener noreferrer" style="margin-left:auto">diff ↗</a>{% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% if corroborations %}
          <ul class="corrob-list">
            {% for row in corroborations %}
            <li class="corrob-row">
              <div class="corrob-head">
                <span class="badge {{ row.cls }}">{{ row.label }}</span>
                <a class="corrob-title" href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a>
              </div>
              {% if row.claim %}<p class="corrob-claim">{{ row.claim }}</p>{% endif %}
              {% if row.evidence %}<p class="corrob-ev">证据 · {{ row.evidence }}</p>{% endif %}
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </section>
        {% endif %}

        {% if personas %}<a href="#board-personas">👥 人物画像<span class="n">{{ personas_count }}</span></a>{% endif %}
        {% for board in boards %}<a href="#board-{{ board.name }}">{{ board.title }}<span class="n">{{ board.count }}</span></a>{% endfor %}
      </nav>
    </div>

    <div class="sidebar-foot">千里眼 qianliyan {{ version }}</div>
  </aside>

  <main class="main-col">
    {% if hero_main %}
    <section class="hero" aria-label="今日头条">
      <p class="hero-label">今日头条</p>
      <article class="hero-main">
        <h2 class="card-title">
          {% for badge in hero_main.badges %}<span class="badge badge-{{ badge.kind }}">{{ badge.label }}</span>{% endfor %}
          <a href="{{ hero_main.url }}" target="_blank" rel="noopener noreferrer">{{ hero_main.display_title }}</a>
        </h2>
        {% if hero_main.summary %}<p class="card-summary hero-summary">{{ hero_main.summary }}</p>{% endif %}
        {% if hero_main.cross_refs %}<p class="more-sources">更多信源：{{ hero_main.other_sources_text }}</p>{% endif %}
        <div class="card-meta">
          <span class="sources">{{ hero_main.lead_source }}</span>
          <span title="{{ hero_main.date_abs }}">🕒 {{ hero_main.date_text }}</span>
          <span class="hotness">🔥 {{ hero_main.hotness }}</span>
          <a class="go" href="{{ hero_main.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
        </div>
      </article>
      {% if hero_rest %}
      <ol class="hero-side">
        {% for item in hero_rest %}
        <li class="hero-row">
          <h3 class="card-title">
            {% for badge in item.badges %}<span class="badge badge-{{ badge.kind }}">{{ badge.label }}</span>{% endfor %}
            <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.display_title }}</a>
          </h3>
          {% if item.summary %}<p class="card-summary">{{ item.summary }}</p>{% endif %}
          {% if item.cross_refs %}<p class="more-sources">更多信源：{{ item.other_sources_text }}</p>{% endif %}
          <div class="card-meta">
            <span class="sources">{{ item.lead_source }}</span>
            <span class="hotness">🔥 {{ item.hotness }}</span>
            <a class="go" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
          </div>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </section>
    {% endif %}

    {% if personalized %}
    <section class="special-board" id="board-personalized" data-board="personalized">
      <div class="board-head">
        <h2>✨ 为你推荐</h2>
        <span class="n">{{ personalized_count }} 条</span>
        <span class="desc">按个性化得分降序 · 命中你的兴趣</span>
      </div>
      <ol class="cards">
        {% for item in personalized %}
        <li class="card" id="{{ item.anchor }}" data-sig="{{ item.sig }}">
          {% if item.avatar_src %}<img class="avatar" src="{{ item.avatar_src }}" alt="{{ item.source }}" loading="lazy">{% endif %}
          {% if not item.avatar_src %}<span class="avatar" style="background: {{ item.avatar_color }}" aria-hidden="true">{{ item.avatar_initial }}</span>{% endif %}
          <div class="card-main">
            <h3 class="card-title">
              {% for badge in item.badges %}<span class="badge badge-{{ badge.kind }}">{{ badge.label }}</span>{% endfor %}
              <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.display_title }}</a>
            </h3>
            {% if item.summary %}<p class="card-summary">{{ item.summary }}</p>{% endif %}
            {% if item.cross_refs %}<p class="more-sources">更多信源：{{ item.other_sources_text }}</p>{% endif %}
            <div class="reasons">
              <span class="pscore">✨ {{ item.personal_score }}</span>
              {% for chip in item.personal_reasons %}<span class="reason-chip">{{ chip.text }}</span>{% endfor %}
            </div>
            <div class="card-meta">
              <span class="sources">{{ item.lead_source }}</span>
              <span title="{{ item.date_abs }}">🕒 {{ item.date_text }}</span>
              <span class="hotness">🔥 {{ item.hotness }}</span>
              <a class="go" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
            </div>
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    {% if personas %}
    <section class="special-board" id="board-personas" data-board="personas">
      <div class="board-head">
        <h2>👥 人物画像</h2>
        <span class="n">{{ personas_count }} 位</span>
        <span class="desc">大牛影响力聚合 · 近期在关注</span>
      </div>
      <div class="persona-grid">
        {% for p in personas %}
        <div class="persona-card">
          <div class="persona-top">
            {% if p.avatar_src %}<img class="avatar" src="{{ p.avatar_src }}" alt="{{ p.handle }}" loading="lazy">{% endif %}
            {% if not p.avatar_src %}<span class="avatar" style="background: {{ p.avatar_color }}" aria-hidden="true">{{ p.avatar_initial }}</span>{% endif %}
            <div>
              <div class="persona-name">{{ p.name }}</div>
              <div class="persona-handle">@{{ p.handle }}</div>
            </div>
          </div>
          {% if p.bio %}<p class="persona-bio">{{ p.bio }}</p>{% endif %}
          {% if p.recent_focus %}<div class="persona-focus"><b>近期在关注：</b>{{ p.recent_focus }}</div>{% endif %}
          {% if p.topics %}<div class="persona-topics">{% for t in p.topics %}<span class="topic-chip">{{ t.text }}</span>{% endfor %}</div>{% endif %}
          {% if p.top_items %}
          <ul class="persona-tops">
            {% for it in p.top_items %}<li>· <a href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it.title }}</a></li>{% endfor %}
          </ul>
          {% endif %}
          <div class="persona-stats">
            <span>总互动 <b>{{ p.total_engagement }}</b></span>
            <span>动态 <b>{{ p.item_count }}</b></span>
            <span>均互动 <b>{{ p.avg_engagement }}</b></span>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% for board in boards %}
    <section class="board" id="board-{{ board.name }}" data-board="{{ board.name }}">
      <div class="board-head">
        <h2>{{ board.title }}</h2>
        <span class="n">{{ board.count }} 条</span>
        <span class="desc">{{ board.desc }}</span>
      </div>
      {% if board.is_empty %}<p class="empty">本版面暂无条目。</p>{% endif %}
      <ol class="cards" data-sort-root="1">
        {% for item in board.items %}
        <li class="card" id="{{ item.anchor }}"
            data-sig="{{ item.sig }}"
            data-title="{{ item.display_title }}"
            data-url="{{ item.url }}"
            data-hotness="{{ item.hotness }}"
            data-ts="{{ item.ts }}"
            data-weight="{{ item.weight }}">
          {% if item.avatar_src %}<img class="avatar" src="{{ item.avatar_src }}" alt="{{ item.source }}" loading="lazy">{% endif %}
          {% if not item.avatar_src %}<span class="avatar" style="background: {{ item.avatar_color }}" aria-hidden="true">{{ item.avatar_initial }}</span>{% endif %}
          <div class="card-main">
            <h3 class="card-title">
              {% for badge in item.badges %}<span class="badge badge-{{ badge.kind }}">{{ badge.label }}</span>{% endfor %}
              <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.display_title }}</a>
            </h3>
            {% if item.summary %}<p class="card-summary">{{ item.summary }}</p>{% endif %}
            {% if item.cross_refs %}<p class="more-sources">更多信源：{{ item.other_sources_text }}</p>{% endif %}
            <div class="card-meta">
              <span class="sources">{{ item.lead_source }}</span>
              <span title="{{ item.date_abs }}">🕒 {{ item.date_text }}</span>
              <span class="hotness">🔥 {{ item.hotness }}</span>
              <span>📈 {{ item.weight }}</span>
              {% if item.tier %}<span class="tier">{{ item.tier }}</span>{% endif %}
              <a class="go" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
            </div>
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endfor %}

    <footer>
      千里眼 qianliyan {{ version }} · 数据生成于 {{ generated_at }} ·
      徽标说明：📈 重磅（≥3 家信源交叉报道）、⚡ 一手速报（高权威信源 24 小时内）。
      本页为单文件自包含简报，可直接分享或离线打开。
    </footer>
  </main>
</div>

<div class="palette-mask" id="qly-palette" role="dialog" aria-modal="true" aria-label="命令面板">
  <div class="palette">
    <input type="text" id="qly-palette-input" placeholder="输入关键词，模糊过滤全部版面的条目…" autocomplete="off" spellcheck="false">
    <ul class="palette-results" id="qly-palette-results"></ul>
    <div class="palette-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开原文</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<script type="application/json" id="qly-data">{{ data_json|safe }}</script>
<script>
(function () {
  "use strict";

  /* ---------- 数据 ---------- */
  var INDEX = [];
  try {
    var node = document.getElementById("qly-data");
    INDEX = JSON.parse(node.textContent || "[]") || [];
  } catch (err) {
    INDEX = [];
  }

  function num(el, name) {
    var v = parseFloat(el.getAttribute("data-" + name));
    return isNaN(v) ? 0 : v;
  }

  /* ---------- 三排序按钮：原地重排 ---------- */
  var COMPARATORS = {
    hot: function (a, b) { return num(b, "hotness") - num(a, "hotness"); },
    time: function (a, b) { return num(b, "ts") - num(a, "ts"); },
    score: function (a, b) { return num(b, "weight") - num(a, "weight"); }
  };

  function applySort(mode) {
    var cmp = COMPARATORS[mode] || COMPARATORS.hot;
    var roots = document.querySelectorAll("[data-sort-root]");
    for (var i = 0; i < roots.length; i++) {
      var root = roots[i];
      var cards = Array.prototype.slice.call(root.children);
      cards.sort(cmp);
      for (var j = 0; j < cards.length; j++) { root.appendChild(cards[j]); }
    }
    var btns = document.querySelectorAll(".sort-btn");
    for (var k = 0; k < btns.length; k++) {
      btns[k].setAttribute("aria-pressed", btns[k].getAttribute("data-sort") === mode ? "true" : "false");
    }
  }

  var sortBtns = document.querySelectorAll(".sort-btn");
  for (var s = 0; s < sortBtns.length; s++) {
    sortBtns[s].addEventListener("click", function (ev) {
      applySort(ev.currentTarget.getAttribute("data-sort"));
    });
  }

  /* ---------- Ctrl+K 命令面板：跨版面模糊过滤 ---------- */
  var mask = document.getElementById("qly-palette");
  var input = document.getElementById("qly-palette-input");
  var list = document.getElementById("qly-palette-results");
  var openBtn = document.getElementById("qly-palette-open");
  var matches = [];
  var cursor = 0;

  function fuzzy(needle, hay) {
    if (!needle) { return true; }
    var i = 0;
    for (var p = 0; p < hay.length && i < needle.length; p++) {
      if (hay.charAt(p) === needle.charAt(i)) { i++; }
    }
    return i === needle.length;
  }

  function score(needle, row) {
    var hay = row.s;
    if (!needle) { return 0; }
    var direct = hay.indexOf(needle);
    if (direct >= 0) { return direct; }
    return fuzzy(needle, hay) ? 1000 + hay.length : -1;
  }

  function render() {
    list.innerHTML = "";
    if (!matches.length) {
      var none = document.createElement("li");
      none.className = "palette-empty";
      none.textContent = "没有匹配的条目";
      list.appendChild(none);
      return;
    }
    for (var i = 0; i < matches.length; i++) {
      var row = matches[i];
      var li = document.createElement("li");
      li.className = i === cursor ? "active" : "";
      var t = document.createElement("div");
      t.className = "pt";
      t.textContent = row.t;
      var m = document.createElement("div");
      m.className = "pm";
      m.textContent = row.b + " · " + row.src + " · 🔥 " + row.h;
      li.appendChild(t);
      li.appendChild(m);
      li.setAttribute("data-idx", String(i));
      li.addEventListener("click", function (ev) {
        jump(parseInt(ev.currentTarget.getAttribute("data-idx"), 10));
      });
      list.appendChild(li);
    }
  }

  function search(text) {
    var needle = (text || "").trim().toLowerCase();
    var scored = [];
    for (var i = 0; i < INDEX.length; i++) {
      var sc = needle ? score(needle, INDEX[i]) : i;
      if (sc >= 0) { scored.push([sc, i, INDEX[i]]); }
    }
    scored.sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; });
    matches = [];
    for (var j = 0; j < scored.length && j < 40; j++) { matches.push(scored[j][2]); }
    cursor = 0;
    render();
  }

  function jump(index) {
    var row = matches[index];
    if (!row) { return; }
    var card = document.getElementById(row.id);
    if (card) {
      card.scrollIntoView({ behavior: "smooth", block: "center" });
      card.classList.add("qly-flash-target");
      setTimeout(function () { card.classList.remove("qly-flash-target"); }, 1600);
    }
    close();
    if (row.u) { window.open(row.u, "_blank", "noopener"); }
  }

  function open() {
    mask.classList.add("open");
    input.value = "";
    search("");
    input.focus();
  }

  function close() {
    mask.classList.remove("open");
  }

  if (openBtn) { openBtn.addEventListener("click", open); }
  if (mask) {
    mask.addEventListener("click", function (ev) {
      if (ev.target === mask) { close(); }
    });
  }
  if (input) {
    input.addEventListener("input", function () { search(input.value); });
  }

  document.addEventListener("keydown", function (ev) {
    var isOpen = mask && mask.classList.contains("open");
    if ((ev.ctrlKey || ev.metaKey) && (ev.key === "k" || ev.key === "K")) {
      ev.preventDefault();
      if (isOpen) { close(); } else { open(); }
      return;
    }
    if (!isOpen) { return; }
    if (ev.key === "Escape") { ev.preventDefault(); close(); return; }
    if (ev.key === "ArrowDown") {
      ev.preventDefault();
      cursor = matches.length ? (cursor + 1) % matches.length : 0;
      render();
      return;
    }
    if (ev.key === "ArrowUp") {
      ev.preventDefault();
      cursor = matches.length ? (cursor - 1 + matches.length) % matches.length : 0;
      render();
      return;
    }
    if (ev.key === "Enter") { ev.preventDefault(); jump(cursor); }
  });

  applySort("hot");
})();
</script>
</body>
</html>
