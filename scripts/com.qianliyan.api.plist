<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qianliyan.api</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>qianliyan.cli.api_server</string>
        <!-- 只监听本机：QLY_API_KEY 未设时无鉴权，不能暴露到局域网 -->
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8787</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>QLY_DATA_DIR</key>
        <string>__DATA_DIR__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>StandardOutPath</key>
    <string>__DATA_DIR__/logs/api.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/logs/api.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
