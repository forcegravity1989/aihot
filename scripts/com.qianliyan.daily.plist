<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qianliyan.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/qly-daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- 装载多在白天调试时，不必立刻抓一轮 -->
    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd 不读 shell profile，数据目录必须显式给出 -->
        <key>QLY_DATA_DIR</key>
        <string>__DATA_DIR__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- 脚本自己写日志；这两个只兜住启动前就失败的情况 -->
    <key>StandardOutPath</key>
    <string>__DATA_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/logs/launchd.err.log</string>

    <!-- 卡死的任务不许长期占着锁 -->
    <key>ExitTimeOut</key>
    <integer>1800</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
